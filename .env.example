# Auth is optional — public services work anonymously.
# Modes are checked in this order; set only one group.

# 1. ArcGIS Online API key
#ARCGIS_API_KEY=

# 2. OAuth2 client_credentials (AGOL app registration)
#ARCGIS_CLIENT_ID=
#ARCGIS_CLIENT_SECRET=

# 3. Legacy generateToken (on-prem ArcGIS Enterprise)
#ARCGIS_USERNAME=
#ARCGIS_PASSWORD=
#ARCGIS_PORTAL_URL=https://your-portal.example.com/portal

# 3b. Standalone ArcGIS Server (no Portal): point generateToken at the server's own
#     token endpoint instead. Combine with ARCGIS_USERNAME/PASSWORD; omit PORTAL_URL.
#ARCGIS_TOKEN_URL=https://your-server.example.com:6443/arcgis/tokens/generateToken

# 4. IWA / Integrated Windows Authentication (NTLM web-tier auth).
#    Requires the optional dependency: uv sync --extra iwa
#    Username is DOMAIN\user or user@domain.
#ARCGIS_USE_NTLM=true
#ARCGIS_USERNAME=
#ARCGIS_PASSWORD=

# Custom geocoder: any ArcGIS GeocodeServer endpoint (Enterprise locator, standalone
# server, or custom). Defaults to the AGOL World Geocoder when unset.
#ARCGIS_GEOCODER_URL=https://your-server.example.com/arcgis/rest/services/YourLocator/GeocodeServer

# Token scoping: credentials are only sent to their home host (AGOL creds -> *.arcgis.com,
# Enterprise/standalone tokens -> the portal/token host). All other hosts are anonymous.
# Federated deployments where servers live on different hostnames than the portal can
# opt extra hosts in (comma-separated).
#ARCGIS_TOKEN_HOSTS=gis.example.com,imagery.example.com
